---
import Site from '../layouts/Site.astro';
import SocialChannels from '../components/SocialChannels.astro';
import { content,faqs } from '../data/content';
import { projects } from '../data/projects';
import { updates } from '../data/updates';
import { pillars,loopZh,loopEn } from '../data/research';
import { company } from '../data/company';
import { localPath } from '../data/navigation';

export function getStaticPaths(){
 const base=['','research','projects','updates','about','contact','media','faq','privacy','terms'];
 const paths=base.flatMap(p=>['zh','en'].map(lang=>({params:{path:(lang==='en'?'en'+(p?'/':''):'')+p||undefined},props:{lang,path:p?`/${p}/`:'/'}})));
 for(const p of projects)for(const lang of ['zh','en'])paths.push({params:{path:(lang==='en'?'en/':'')+'projects/'+p.slug},props:{lang,path:'/projects/'+p.slug+'/'}});
 for(const p of updates)for(const lang of ['zh','en'])paths.push({params:{path:(lang==='en'?'en/':'')+'updates/'+p.slug},props:{lang,path:'/updates/'+p.slug+'/'}});
 return paths;
}
const {lang,path}=Astro.props as {lang:'zh'|'en';path:string};
const c=content[lang];const key=path==='/'?'home':path.split('/')[1];
const project=key==='projects'?projects.find(p=>path.includes('/'+p.slug+'/')):undefined;
const update=key==='updates'?updates.find(p=>path.includes('/'+p.slug+'/')):undefined;
const page=c[key as keyof typeof c] as {title:string;kicker:string;lead:string;body:string}|undefined;
const title=project?`${project.name} | ${lang==='zh'?'项目 · 勘境':'Projects · KineWorld'}`:update?`${lang==='zh'?update.titleZh:update.titleEn} | KineWorld`:key==='home'?(lang==='zh'?'勘境 KineWorld｜世界模型与具身智能':'KineWorld | World Models for Physical Intelligence'):`${page?.title} | ${lang==='zh'?'勘境 KineWorld':'KineWorld'}`;
const description=project?(lang==='zh'?project.zh:project.en):update?(lang==='zh'?update.summaryZh:update.summaryEn):page?.body||'';
const tx=(zh:string,en:string)=>lang==='zh'?zh:en;
const titlePhrases=(value:string)=>value.match(/[^，。！？]+[，。！？]?/g) || [value];
---
<Site lang={lang} path={path} title={title} description={description} hero={key==='home'}>
{key==='home' ? <>
 <section class="hero"><div class="hero-image" aria-hidden="true"></div><div class="hero-shade" aria-hidden="true"></div><div class="hero-content"><p class="eyebrow">勘境 <span>KINEWORLD</span></p><h1>{lang==='zh'?titlePhrases(c.home.title).map(phrase=><span class="title-phrase">{phrase}</span>):c.home.title}</h1><p class="hero-lead">{lang==='zh'?titlePhrases(c.home.lead).map(phrase=><span class="lead-phrase">{phrase}</span>):c.home.lead}</p><p class="hero-body">{c.home.body}</p><div class="button-row"><a class="button primary" href={localPath('/research/',lang)}>{c.links.research}<span>↗</span></a><a class="button secondary" href={localPath('/about/',lang)}>{c.links.about}<span>↗</span></a></div></div><div class="hero-bottom"><span>{c.home.kicker}</span><span>{tx('向下，进入勘境 ↓','SCROLL TO ENTER ↓')}</span></div></section>
 <section class="section thesis-section"><p class="section-index">01 / THE RESEARCH QUESTION</p><div class="thesis-grid"><h2>{tx('如果采取这个动作，世界会怎样变化？','If we act, how might the world change?')}</h2><div><p class="large-copy">{tx('勘境智能围绕动作条件世界模型开展研究：从观测中建立表征，预测动作可能带来的变化，并探索如何用预测支持规划。','KineWorld researches action-conditioned world models: learning representations from observations, anticipating the effects of actions, and exploring how predictions can inform planning.')}</p><p>{tx('这是一条研究路径。每项能力的有效性都需要在具体任务、数据与基线下验证。','This is a research path. Each capability needs validation against specific tasks, data and baselines.')}</p><a class="text-link" href={localPath('/research/',lang)}>{c.links.research} ↗</a></div></div></section>
 <section class="section origin-section"><p class="section-index">02 / THE NAME</p><div class="origin-grid"><div><h2>{tx('勘其未知，见其世界。','Survey the unknown. Understand the world.')}</h2><p class="large-copy">{tx('勘境的名字来自研究的方法与对象。','The name KineWorld begins with a way of working and the world it studies.')}</p></div><div class="origin-words"><p><span>勘</span>{tx('探查、测量、核验。先把世界看清楚。','Survey, measure, verify. First, understand what is here.')}</p><p><span>境</span>{tx('环境、边界与可能的未来。再理解它如何变化。','Environment, boundaries and possible futures. Then, understand how they change.')}</p><a class="text-link" href={localPath('/about/',lang)}>{c.links.about} ↗</a></div></div></section>
 <section class="section world-section"><p class="section-index">03 / {c.labels.world}</p><div class="split"><div><h2>{tx('从看见世界，走向理解变化。','From seeing to understanding change.')}</h2></div><div><p class="large-copy">{tx('感知系统回答：“我现在看见什么？”世界模型进一步尝试回答：“如果我这样行动，接下来会发生什么？”','Perception asks, “What is here now?” A world model asks, “What might happen if I take this action?”')}</p><p>{tx('预测不等于确定。研究需要记录假设、失败和适用边界。','Prediction is never certainty. Research must record assumptions, failures and boundaries.')}</p></div></div></section>
 <section class="section route-section"><p class="section-index">04 / {c.labels.route} · RESEARCH DIRECTION</p><h2>{tx('从观测，到反馈。','From observation to feedback.')}</h2><ol class="route-list">{(lang==='zh'?loopZh:loopEn).map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span><strong>{item}</strong></li>)}</ol><p class="muted">{tx('这是研究路线示意，并非成熟能力清单。','This is a research path, not a list of mature capabilities.')}</p></section>
 <section class="section"><p class="section-index">05 / RESEARCH PILLARS</p><h2>{tx('研究方向','Research pillars')}</h2><div class="pillar-grid">{pillars.map((p,i)=><article class="pillar"><span>0{i+1}</span><h3>{lang==='zh'?p.zh:p.en}</h3><p>{lang==='zh'?p.descZh:p.descEn}</p></article>)}</div></section>
 <section class="section"><div class="section-heading"><div><p class="section-index">06 / PROJECTS</p><h2>{c.labels.selected}</h2></div><a class="text-link" href={localPath('/projects/',lang)}>{c.links.projects} ↗</a></div><div class="project-grid">{projects.slice(0,3).map(p=><a class="project-card" href={localPath('/projects/'+p.slug+'/',lang)}><span class="card-top">{p.kind==='first'?c.labels.first:c.labels.adaptation} <span>↗</span></span><h3>{p.name}</h3><p>{lang==='zh'?p.zh:p.en}</p><small>{lang==='zh'?p.statusZh:p.statusEn}</small></a>)}</div></section>
 <section class="section evidence-section"><p class="section-index">07 / OPEN RESEARCH</p><div class="split"><h2>{c.labels.proof}</h2><div><p class="large-copy">{tx('我们希望把研究主张绑定到可以检查的代码、实验、评测和限制说明。','We aim to connect research claims to inspectable code, experiments, evaluations and limitations.')}</p><a class="text-link" href={company.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></section>
 <section class="section future-section"><p class="section-index">08 / WHAT COMES NEXT</p><h2>{tx('先把下一步想清楚。','Think through the next step.')}</h2><p class="large-copy">{tx('从可复现的研究出发，逐步走向能比较未来、辅助行动的系统。','From reproducible research toward systems that can compare possible futures before acting.')}</p><div class="future-grid"><article><span>01 / {tx('现在','NOW')}</span><h3>{tx('建立可检查的起点','Build inspectable foundations')}</h3><p>{tx('公开项目覆盖动作预测、潜在动力学和评测；当前状态以各仓库的代码与模型说明为准。','Public projects cover action prediction, latent dynamics and evaluation. The repositories and model cards define their current status.')}</p></article><article><span>02 / {tx('接下来','NEXT')}</span><h3>{tx('检验更长的未来','Test longer horizons')}</h3><p>{tx('计划探索统一数据与评测接口，以及动作条件多步预测和规划实验。','We plan to explore shared data and evaluation interfaces, action-conditioned multi-step prediction and planning experiments.')}</p></article><article><span>03 / {tx('长期愿景','LONG TERM')}</span><h3>{tx('让智能先推演，再行动','Anticipate before acting')}</h3><p>{tx('在可控环境中验证：模型能否帮助系统理解后果、选择动作，并承认不确定性。','Test in controlled settings whether models can help systems understand consequences, choose actions and account for uncertainty.')}</p></article></div><p class="muted">{tx('后两项是研究方向，不是已交付能力或时间承诺；路线会随实验结果调整。','The latter two are research directions, not delivered capabilities or timeline commitments; the path will change with evidence.')}</p></section>
 <section class="section"><div class="section-heading"><div><p class="section-index">09 / UPDATES</p><h2>{c.labels.latest}</h2></div><a class="text-link" href={localPath('/updates/',lang)}>{tx('所有进展','All updates')} ↗</a></div><div class="update-list">{updates.map(u=><a href={localPath('/updates/'+u.slug+'/',lang)}><time datetime={u.date}>{u.date}</time><span>{lang==='zh'?u.categoryZh:u.categoryEn}</span><strong>{lang==='zh'?u.titleZh:u.titleEn}</strong><span>↗</span></a>)}</div></section>
 <section class="closing"><div><p class="section-index">KINEWORLD / 勘境</p><h2>{tx('让研究可以被检验。','Make the research inspectable.')}</h2><div class="button-row"><a class="button primary" href={localPath('/research/',lang)}>{c.links.research} ↗</a><a class="button secondary" href={localPath('/projects/',lang)}>{c.links.projects} ↗</a></div></div></section>
 </> : project ? <>
 <section class="page-hero"><p class="eyebrow">PROJECT / {project.kind==='first'?c.labels.first:c.labels.adaptation}</p><h1>{project.name}</h1><p class="page-lead">{lang==='zh'?project.zh:project.en}</p><div class="meta-line"><span>{c.labels.status}: {lang==='zh'?project.statusZh:project.statusEn}</span><a href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></section>
 <div class="detail-layout"><aside><a href={localPath('/projects/',lang)}>← {c.links.projects}</a><span>01—09</span></aside><div class="detail-content"><section><p class="section-index">01 / {c.labels.overview}</p><h2>{project.name}</h2><p>{lang==='zh'?project.zh:project.en}</p></section><section><p class="section-index">02 / {c.labels.problem}</p><h2>{c.labels.problem}</h2><p>{lang==='zh'?project.problemZh:project.problemEn}</p></section><section><p class="section-index">03 / {c.labels.approach}</p><h2>{c.labels.approach}</h2><p>{lang==='zh'?project.approachZh:project.approachEn}</p></section><section><p class="section-index">04 / {c.labels.architecture}</p><h2>{c.labels.architecture}</h2><p>{tx('具体架构与接口以仓库文档和代码为准。此处只描述已公开的研究范围。','Consult repository documentation and code for exact architecture and interfaces. This page describes only the public research scope.')}</p></section><section><p class="section-index">05 / {c.labels.status}</p><h2>{lang==='zh'?project.statusZh:project.statusEn}</h2></section><section><p class="section-index">06 / {c.labels.evidence}</p><h2>{c.labels.evidence}</h2><a class="text-link" href={project.evidence} target="_blank" rel="noopener noreferrer">{c.links.evidence} ↗</a></section><section><p class="section-index">07 / {c.labels.limitations}</p><h2>{c.labels.limitations}</h2><p>{lang==='zh'?project.limitsZh:project.limitsEn}</p></section><section><p class="section-index">08 / CODE</p><h2>Repository</h2><a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">{project.repo} ↗</a>{project.upstream&&<p><a class="text-link" href={project.upstream} target="_blank" rel="noopener noreferrer">{c.links.upstream} ↗</a></p>}</section><section><p class="section-index">09 / {c.labels.next}</p><h2>{c.labels.next}</h2><p>{tx('后续结果以仓库中新增的可核验实验与文档为准。','Follow new inspectable experiments and documentation in the repository.')}</p></section></div></div>
 </> : update ? <><section class="page-hero"><p class="eyebrow">{lang==='zh'?update.categoryZh:update.categoryEn} / <time datetime={update.date}>{update.date}</time></p><h1>{lang==='zh'?titlePhrases(update.titleZh).map(phrase=><span class="title-phrase">{phrase}</span>):update.titleEn}</h1><p class="page-lead">{lang==='zh'?update.summaryZh:update.summaryEn}</p></section><article class="article"><p>{lang==='zh'?update.bodyZh:update.bodyEn}</p><p><a class="text-link" href={update.source} target="_blank" rel="noopener noreferrer">{c.links.evidence} ↗</a></p><a href={localPath('/updates/',lang)}>← {tx('返回进展','Back to updates')}</a></article></> : <>
 <section class:list={["page-hero", `${key}-page-hero`]}><p class="eyebrow">{page?.kicker}</p><h1>{lang==='zh'&&page?.title?titlePhrases(page.title).map(phrase=><span class="title-phrase">{phrase}</span>):page?.title}</h1><p class="page-lead">{page?.lead}</p><p class="page-body">{page?.body}</p></section>
 {key==='research'&&<><section class="section"><p class="section-index">RESEARCH PHILOSOPHY</p><div class="split"><h2>{tx('世界模型是什么？','What is a world model?')}</h2><p class="large-copy">{tx('给定当前观测和一种可能的动作，尝试推测环境接下来会怎样变化。这样的预测可帮助系统比较未来并选择行动。','Given current observations and a possible action, it tries to anticipate how the environment might change. These predictions can help a system compare futures before acting.')}</p></div></section><section class="section route-section"><p class="section-index">RESEARCH DIRECTION · {c.labels.route}</p><ol class="route-list">{(lang==='zh'?loopZh:loopEn).map((x,i)=><li><span>{String(i+1).padStart(2,'0')}</span><strong>{x}</strong></li>)}</ol><p>{tx('路线示意，不代表所有组件已验证或可用于真实机器人。','A research map, not a claim that every component is validated or deployable on a physical robot.')}</p></section><section class="section"><p class="section-index">FOCUS AREAS</p><div class="pillar-grid">{pillars.map((p,i)=><article class="pillar"><span>0{i+1}</span><h2>{lang==='zh'?p.zh:p.en}</h2><p>{lang==='zh'?p.descZh:p.descEn}</p><p class="muted">{tx('当前：研究方向。具体实现与测试参见相关仓库。','Current stage: research direction. See related repositories for implementation and tests.')}</p></article>)}</div></section><section class="section evidence-section"><h2>{tx('评测与开放研究','Evaluation and open research')}</h2><p class="large-copy">{tx('模型能力需通过明确任务、数据、基线和失败分析验证。kine-bench 用于建立这样的证据门禁。','Model capabilities require clearly defined tasks, data, baselines and failure analysis. kine-bench explores this evidence gate.')}</p><a class="text-link" href="https://github.com/kineworld/kine-bench" target="_blank" rel="noopener noreferrer">kine-bench ↗</a></section></>}
 {key==='projects'&&<><section class="section"><p class="section-index">01 / {c.labels.first}</p><div class="project-grid">{projects.filter(p=>p.kind==='first').map(p=><a class="project-card" href={localPath('/projects/'+p.slug+'/',lang)}><span class="card-top">{c.labels.first}<span>↗</span></span><h2>{p.name}</h2><p>{lang==='zh'?p.zh:p.en}</p><small>{lang==='zh'?p.statusZh:p.statusEn}</small></a>)}</div></section><section class="section"><p class="section-index">02 / {c.labels.adaptation}</p><p class="muted">{tx('此类别建立在注明来源的上游项目上。工程改动不构成对上游模型能力的所有权或性能证明。','This category builds on attributed upstream work. Engineering changes do not transfer ownership of upstream model capabilities or validate performance.')}</p><div class="project-grid">{projects.filter(p=>p.kind==='adaptation').map(p=><a class="project-card" href={localPath('/projects/'+p.slug+'/',lang)}><span class="card-top">{c.labels.adaptation}<span>↗</span></span><h2>{p.name}</h2><p>{lang==='zh'?p.zh:p.en}</p><small>{lang==='zh'?p.statusZh:p.statusEn}</small></a>)}</div></section></>}
 {key==='updates'&&<section class="section"><div class="update-list">{updates.map(u=><a href={localPath('/updates/'+u.slug+'/',lang)}><time datetime={u.date}>{u.date}</time><span>{lang==='zh'?u.categoryZh:u.categoryEn}</span><strong>{lang==='zh'?u.titleZh:u.titleEn}</strong><span>↗</span></a>)}</div></section>}
 {key==='about'&&<><section class="section thesis-section"><p class="section-index">KINEWORLD / 勘境</p><div class="thesis-grid"><h2>{tx('研究能够理解变化、预见后果的世界模型。','Researching world models that anticipate change.')}</h2><div><p class="large-copy">{tx('「勘」是探查与理解，「境」是环境与世界。勘境智能从这个问题出发：智能体如何根据观测和动作，推测可能的未来？','The Chinese name joins surveying and understanding with environments and the world. We begin with a question: how can an agent use observations and actions to anticipate possible futures?')}</p><p>{tx('我们的工作围绕预测表征、动作条件推演、规划与评测。公开项目展示研究代码、工程实践与当前限制。','Our work centers on predictive representations, action-conditioned rollout, planning and evaluation. Public projects show research code, engineering work and current limitations.')}</p><a class="text-link" href={localPath('/projects/',lang)}>{c.links.projects} ↗</a></div></div></section><section class="section"><p class="section-index">RESEARCH PRINCIPLES</p><div class="pillar-grid">{[['Evidence before claims','证据先于宣传'],['Open when possible','尽可能开放'],['Failures matter','重视失败结果'],['Prediction before action','行动之前先推演']].map(x=><article class="pillar"><h3>{lang==='zh'?x[1]:x[0]}</h3><p>{lang==='zh'?x[0]:x[1]}</p></article>)}</div></section><section class="section"><p class="section-index">COMPANY</p><h2>{tx('关于勘境智能','About the company')}</h2><p>{tx('勘境智能是合肥勘境智能科技有限公司的品牌。当前官网展示研究方向与公开工程项目；未公开核验的模型成绩、商业产品和团队信息不作宣称。','KineWorld is the brand of Hefei KineWorld Intelligent Technology Co., Ltd. This site presents research directions and public engineering projects; it does not claim unverified model results, commercial products or team details.')}</p><a class="text-link" href={company.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></section></>}
 {key==='contact'&&<>
  <section class="section"><p class="section-index">{c.labels.social}</p><div class="contact-card"><div><span>01 / PUBLIC CHANNEL</span><h2>GitHub</h2><p>{tx('研究讨论、复现问题、开源贡献。请在对应仓库发起 Issue 或 Pull Request。','Research discussion, reproduction reports and open-source contributions. Use issues or pull requests in the relevant repository.')}</p><code>github.com/kineworld</code></div><a class="button primary" href={company.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></section>
  <section class="section"><p class="section-index">02 / RESEARCH PILOT</p><div class="contact-card"><div><span>{tx('免费研究试点意向','NONPAYABLE RESEARCH PILOT')}</span><h2>KineJing</h2><p>{tx('有明确的视频事件、现有人工或规则方案，并愿意讨论获授权样本？可填写试点意向。请勿在公开表单上传视频、个人信息、密钥或商业机密；这不是付费 API 申请。','Have a defined video event, an existing manual or rule-based workflow, and permission to discuss sample data? Share a pilot inquiry. Do not post videos, personal data, keys or confidential material in the public form. This is not a paid API application.')}</p></div><a class="button secondary" href="https://github.com/kineworld/KineJing/issues/new?template=pilot-interest.yml" target="_blank" rel="noopener noreferrer">{tx('填写试点意向','Pilot inquiry')} ↗</a></div></section>
  <SocialChannels lang={lang} />
 </>}
 {key==='media'&&<><section class="section split"><div><p class="section-index">LOGO</p><h2>{c.labels.mediaUse}</h2><p>{tx('请保持标志原有轮廓、中间负空间与比例。不要把它重画为普通方框或声称它是严格的四维超立方体投影。','Preserve the silhouette, central negative space and proportions. Do not redraw it as a generic box or claim it is a strict tesseract projection.')}</p><div class="button-row"><a class="button secondary" href="/assets/logo-original.jpg" download>{tx('原始 JPG','Original JPG')}</a><a class="button secondary" href="/assets/logo-mark.png" download>{tx('透明 PNG','Transparent PNG')}</a><a class="button secondary" href="/assets/logo-white.png" download>{tx('白色 PNG','White PNG')}</a><a class="button secondary" href="/assets/logo-on-black.png" download>{tx('黑底版本','On black')}</a><a class="button secondary" href="/assets/logo-on-white.png" download>{tx('白底版本','On white')}</a></div></div><div class="brand-visual light"><img src="/assets/logo-depth.png" alt={tx('勘境标志','KineWorld mark')} width="480" height="480" /></div></section><section class="section"><p class="section-index">BRAND</p><div class="pillar-grid"><article class="pillar"><h3>勘境智能</h3><p>KineWorld</p></article><article class="pillar"><h3>COLOR</h3><p>#05070B · #006BFF · #F5F7FA</p></article><article class="pillar"><h3>MEDIA CONTACT</h3><p>{tx('当前未公开核验媒体联系邮箱。','No media email is publicly verified yet.')}</p></article></div></section></>}
 {key==='faq'&&<section class="section faq-list">{faqs.map((f,i)=><details><summary><span>{String(i+1).padStart(2,'0')}</span>{lang==='zh'?f.qZh:f.qEn}</summary><p>{lang==='zh'?f.aZh:f.aEn}</p></details>)}</section>}
 {(key==='privacy'||key==='terms')&&<section class="section legal-copy"><p>{page?.body}</p><p>{key==='privacy'?tx('本网站不主动收集通过表单提交的个人信息，因为目前没有联系表单。若未来启用统计或表单，此页会在上线前更新。','The site does not collect form submissions because it currently has no contact form. This page will be updated before any analytics or forms are enabled.'):tx('内容按发布时可核验的资料编写。研究状态会变化，具体实现和许可应以对应公开仓库的最新文件为准。','Content reflects inspectable information at publication. Research status may change; consult the current files in each public repository for implementation and licensing.')}</p></section>}
 </>}
</Site>
