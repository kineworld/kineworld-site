---
import Site from '../layouts/Site.astro';
import { content,faqs } from '../data/content';
import { projects } from '../data/projects';
import { updates } from '../data/updates';
import { pillars,loopZh,loopEn } from '../data/research';
import { company } from '../data/company';
import { localPath } from '../data/navigation';

export function getStaticPaths(){
 const base=['','research','projects','updates','about','contact','media','faq','privacy','terms'];
 const paths=base.flatMap(p=>['zh','en'].map(lang=>({params:{path:(lang==='en'?'en'+(p?'/':''):'')+p||undefined},props:{lang,path:p?`/${p}/`:'/'}})));
 for(const p of projects)for(const lang of ['zh','en'])paths.push({params:{path:(lang==='en'?'en/':'')+'projects/'+p.slug},props:{lang,path:'/projects/'+p.slug+'/'}});
 for(const p of updates)for(const lang of ['zh','en'])paths.push({params:{path:(lang==='en'?'en/':'')+'updates/'+p.slug},props:{lang,path:'/updates/'+p.slug+'/'}});
 return paths;
}
const {lang,path}=Astro.props as {lang:'zh'|'en';path:string};
const c=content[lang];const key=path==='/'?'home':path.split('/')[1];
const project=key==='projects'?projects.find(p=>path.includes('/'+p.slug+'/')):undefined;
const update=key==='updates'?updates.find(p=>path.includes('/'+p.slug+'/')):undefined;
const page=c[key as keyof typeof c] as {title:string;kicker:string;lead:string;body:string}|undefined;
const title=project?`${project.name} | ${lang==='zh'?'项目 · 勘境':'Projects · KineWorld'}`:update?`${lang==='zh'?update.titleZh:update.titleEn} | KineWorld`:key==='home'?(lang==='zh'?'勘境 KineWorld｜世界模型与具身智能':'KineWorld | World Models for Physical Intelligence'):`${page?.title} | ${lang==='zh'?'勘境 KineWorld':'KineWorld'}`;
const description=project?(lang==='zh'?project.zh:project.en):update?(lang==='zh'?update.summaryZh:update.summaryEn):page?.body||'';
const tx=(zh:string,en:string)=>lang==='zh'?zh:en;
---
<Site lang={lang} path={path} title={title} description={description} hero={key==='home'}>
{key==='home' ? <>
 <section class="hero"><div class="hero-image" aria-hidden="true"></div><div class="hero-shade" aria-hidden="true"></div><div class="hero-content"><p class="eyebrow">勘境 <span>KINEWORLD</span></p><h1>{c.home.title}</h1><p class="hero-lead">{c.home.lead}</p><p class="hero-body">{c.home.body}</p><div class="button-row"><a class="button primary" href={localPath('/research/',lang)}>{c.links.research}<span>↗</span></a><a class="button secondary" href={localPath('/about/',lang)}>{c.links.about}<span>↗</span></a></div></div><div class="hero-bottom"><span>{c.home.kicker}</span><span>SCROLL TO EXPLORE ↓</span></div></section>
 <section class="section split"><div><p class="section-index">01 / {c.labels.brand}</p><h2>{tx('为什么是「勘境」','Why KineWorld')}</h2><p class="large-copy">{tx('「勘」是探查、测量与理解。「境」是环境、空间、边界与世界。','The name speaks to surveying and understanding environments, spaces and boundaries.')}</p><p>{tx('我们关注状态如何变化、动作会带来什么结果，以及未来可能走向哪里。','We study how states change, what actions may cause and where possible futures may lead.')}</p><a class="text-link" href={localPath('/about/',lang)}>{c.links.about} ↗</a></div><div class="brand-visual"><img src="/assets/logo-mark.png" alt={tx('勘境蓝色空间标志','KineWorld blue spatial mark')} width="480" height="480" /></div></section>
 <section class="section world-section"><p class="section-index">02 / {c.labels.world}</p><div class="split"><div><h2>{tx('从看见世界，走向理解变化。','From seeing to understanding change.')}</h2></div><div><p class="large-copy">{tx('感知系统回答：“我现在看见什么？”世界模型进一步尝试回答：“如果我这样行动，接下来会发生什么？”','Perception asks, “What is here now?” A world model asks, “What might happen if I take this action?”')}</p><p>{tx('预测不等于确定。研究需要记录假设、失败和适用边界。','Prediction is never certainty. Research must record assumptions, failures and boundaries.')}</p></div></div></section>
 <section class="section route-section"><p class="section-index">03 / {c.labels.route} · RESEARCH DIRECTION</p><h2>{tx('从观测，到反馈。','From observation to feedback.')}</h2><ol class="route-list">{(lang==='zh'?loopZh:loopEn).map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span><strong>{item}</strong></li>)}</ol><p class="muted">{tx('这是研究路线示意，并非成熟能力清单。','This is a research path, not a list of mature capabilities.')}</p></section>
 <section class="section"><p class="section-index">04 / RESEARCH PILLARS</p><h2>{tx('研究方向','Research pillars')}</h2><div class="pillar-grid">{pillars.map((p,i)=><article class="pillar"><span>0{i+1}</span><h3>{lang==='zh'?p.zh:p.en}</h3><p>{lang==='zh'?p.descZh:p.descEn}</p></article>)}</div></section>
 <section class="section"><div class="section-heading"><div><p class="section-index">05 / PROJECTS</p><h2>{c.labels.selected}</h2></div><a class="text-link" href={localPath('/projects/',lang)}>{c.links.projects} ↗</a></div><div class="project-grid">{projects.slice(0,3).map(p=><a class="project-card" href={localPath('/projects/'+p.slug+'/',lang)}><span class="card-top">{p.kind==='first'?c.labels.first:c.labels.adaptation} <span>↗</span></span><h3>{p.name}</h3><p>{lang==='zh'?p.zh:p.en}</p><small>{lang==='zh'?p.statusZh:p.statusEn}</small></a>)}</div></section>
 <section class="section evidence-section"><p class="section-index">06 / OPEN RESEARCH</p><div class="split"><h2>{c.labels.proof}</h2><div><p class="large-copy">{tx('我们希望把研究主张绑定到可以检查的代码、实验、评测和限制说明。','We aim to connect research claims to inspectable code, experiments, evaluations and limitations.')}</p><a class="text-link" href={company.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></section>
 <section class="section"><div class="section-heading"><div><p class="section-index">07 / UPDATES</p><h2>{c.labels.latest}</h2></div><a class="text-link" href={localPath('/updates/',lang)}>{tx('所有进展','All updates')} ↗</a></div><div class="update-list">{updates.map(u=><a href={localPath('/updates/'+u.slug+'/',lang)}><time datetime={u.date}>{u.date}</time><span>{lang==='zh'?u.categoryZh:u.categoryEn}</span><strong>{lang==='zh'?u.titleZh:u.titleEn}</strong><span>↗</span></a>)}</div></section>
 <section class="closing"><div><p class="section-index">BEYOND THE KNOWN</p><h2>{c.labels.door}</h2><div class="button-row"><a class="button primary" href={localPath('/research/',lang)}>{c.links.research} ↗</a><a class="button secondary" href={localPath('/contact/',lang)}>{c.links.contact} ↗</a></div></div></section>
 </> : project ? <>
 <section class="page-hero"><p class="eyebrow">PROJECT / {project.kind==='first'?c.labels.first:c.labels.adaptation}</p><h1>{project.name}</h1><p class="page-lead">{lang==='zh'?project.zh:project.en}</p><div class="meta-line"><span>{c.labels.status}: {lang==='zh'?project.statusZh:project.statusEn}</span><a href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></section>
 <div class="detail-layout"><aside><a href={localPath('/projects/',lang)}>← {c.links.projects}</a><span>01—09</span></aside><div class="detail-content"><section><p class="section-index">01 / {c.labels.overview}</p><h2>{project.name}</h2><p>{lang==='zh'?project.zh:project.en}</p></section><section><p class="section-index">02 / {c.labels.problem}</p><h2>{c.labels.problem}</h2><p>{lang==='zh'?project.problemZh:project.problemEn}</p></section><section><p class="section-index">03 / {c.labels.approach}</p><h2>{c.labels.approach}</h2><p>{lang==='zh'?project.approachZh:project.approachEn}</p></section><section><p class="section-index">04 / {c.labels.architecture}</p><h2>{c.labels.architecture}</h2><p>{tx('具体架构与接口以仓库文档和代码为准。此处只描述已公开的研究范围。','Consult repository documentation and code for exact architecture and interfaces. This page describes only the public research scope.')}</p></section><section><p class="section-index">05 / {c.labels.status}</p><h2>{lang==='zh'?project.statusZh:project.statusEn}</h2></section><section><p class="section-index">06 / {c.labels.evidence}</p><h2>{c.labels.evidence}</h2><a class="text-link" href={project.evidence} target="_blank" rel="noopener noreferrer">{c.links.evidence} ↗</a></section><section><p class="section-index">07 / {c.labels.limitations}</p><h2>{c.labels.limitations}</h2><p>{lang==='zh'?project.limitsZh:project.limitsEn}</p></section><section><p class="section-index">08 / CODE</p><h2>Repository</h2><a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">{project.repo} ↗</a>{project.upstream&&<p><a class="text-link" href={project.upstream} target="_blank" rel="noopener noreferrer">{c.links.upstream} ↗</a></p>}</section><section><p class="section-index">09 / {c.labels.next}</p><h2>{c.labels.next}</h2><p>{tx('后续结果以仓库中新增的可核验实验与文档为准。','Follow new inspectable experiments and documentation in the repository.')}</p></section></div></div>
 </> : update ? <><section class="page-hero"><p class="eyebrow">{lang==='zh'?update.categoryZh:update.categoryEn} / <time datetime={update.date}>{update.date}</time></p><h1>{lang==='zh'?update.titleZh:update.titleEn}</h1><p class="page-lead">{lang==='zh'?update.summaryZh:update.summaryEn}</p></section><article class="article"><p>{lang==='zh'?update.bodyZh:update.bodyEn}</p><p><a class="text-link" href={update.source} target="_blank" rel="noopener noreferrer">{c.links.evidence} ↗</a></p><a href={localPath('/updates/',lang)}>← {tx('返回进展','Back to updates')}</a></article></> : <>
 <section class:list={["page-hero", `${key}-page-hero`]}><p class="eyebrow">{page?.kicker}</p><h1>{page?.title}</h1><p class="page-lead">{page?.lead}</p><p class="page-body">{page?.body}</p></section>
 {key==='research'&&<><section class="section"><p class="section-index">RESEARCH PHILOSOPHY</p><div class="split"><h2>{tx('世界模型是什么？','What is a world model?')}</h2><p class="large-copy">{tx('给定当前观测和一种可能的动作，尝试推测环境接下来会怎样变化。这样的预测可帮助系统比较未来并选择行动。','Given current observations and a possible action, it tries to anticipate how the environment might change. These predictions can help a system compare futures before acting.')}</p></div></section><section class="section route-section"><p class="section-index">RESEARCH DIRECTION · {c.labels.route}</p><ol class="route-list">{(lang==='zh'?loopZh:loopEn).map((x,i)=><li><span>{String(i+1).padStart(2,'0')}</span><strong>{x}</strong></li>)}</ol><p>{tx('路线示意，不代表所有组件已验证或可用于真实机器人。','A research map, not a claim that every component is validated or deployable on a physical robot.')}</p></section><section class="section"><p class="section-index">FOCUS AREAS</p><div class="pillar-grid">{pillars.map((p,i)=><article class="pillar"><span>0{i+1}</span><h2>{lang==='zh'?p.zh:p.en}</h2><p>{lang==='zh'?p.descZh:p.descEn}</p><p class="muted">{tx('当前：研究方向。具体实现与测试参见相关仓库。','Current stage: research direction. See related repositories for implementation and tests.')}</p></article>)}</div></section><section class="section evidence-section"><h2>{tx('评测与开放研究','Evaluation and open research')}</h2><p class="large-copy">{tx('模型能力需通过明确任务、数据、基线和失败分析验证。kine-bench 用于建立这样的证据门禁。','Model capabilities require clearly defined tasks, data, baselines and failure analysis. kine-bench explores this evidence gate.')}</p><a class="text-link" href="https://github.com/kineworld/kine-bench" target="_blank" rel="noopener noreferrer">kine-bench ↗</a></section></>}
 {key==='projects'&&<><section class="section"><p class="section-index">01 / {c.labels.first}</p><div class="project-grid">{projects.filter(p=>p.kind==='first').map(p=><a class="project-card" href={localPath('/projects/'+p.slug+'/',lang)}><span class="card-top">{c.labels.first}<span>↗</span></span><h2>{p.name}</h2><p>{lang==='zh'?p.zh:p.en}</p><small>{lang==='zh'?p.statusZh:p.statusEn}</small></a>)}</div></section><section class="section"><p class="section-index">02 / {c.labels.adaptation}</p><p class="muted">{tx('此类别建立在注明来源的上游项目上。工程改动不构成对上游模型能力的所有权或性能证明。','This category builds on attributed upstream work. Engineering changes do not transfer ownership of upstream model capabilities or validate performance.')}</p><div class="project-grid">{projects.filter(p=>p.kind==='adaptation').map(p=><a class="project-card" href={localPath('/projects/'+p.slug+'/',lang)}><span class="card-top">{c.labels.adaptation}<span>↗</span></span><h2>{p.name}</h2><p>{lang==='zh'?p.zh:p.en}</p><small>{lang==='zh'?p.statusZh:p.statusEn}</small></a>)}</div></section></>}
 {key==='updates'&&<section class="section"><div class="update-list">{updates.map(u=><a href={localPath('/updates/'+u.slug+'/',lang)}><time datetime={u.date}>{u.date}</time><span>{lang==='zh'?u.categoryZh:u.categoryEn}</span><strong>{lang==='zh'?u.titleZh:u.titleEn}</strong><span>↗</span></a>)}</div></section>}
 {key==='about'&&<><section class="section split"><div><p class="section-index">THE MARK</p><h2>{tx('四维感的空间结构','A spatial mark')}</h2><p class="large-copy">{tx('它是品牌意义上的“四维感结构”，像一处通向更深层世界理解的入口；不是对某个严格数学对象的宣称。','The mark evokes a higher-dimensional spatial structure: an entrance to deeper understanding. It is a brand metaphor, not a claim about a mathematically defined object.')}</p></div><div class="brand-visual"><img src="/assets/logo-mark.png" alt={tx('勘境标志','KineWorld mark')} width="480" height="480" /></div></section><section class="section split"><div><p class="section-index">THE PORTAL</p><h2>{tx('通往未知世界的门','A door to the unknown')}</h2></div><p class="large-copy">{tx('从观察到理解，从当前状态到可能未来。门代表研究面对未知时保持好奇和审慎。','From observation to understanding, from the current state to possible futures. The portal expresses curiosity and care in the face of uncertainty.')}</p></section><section class="section"><p class="section-index">RESEARCH PRINCIPLES</p><div class="pillar-grid">{[['Evidence before claims','证据先于宣传'],['Open when possible','尽可能开放'],['Failures matter','重视失败结果'],['Prediction before action','行动之前先推演']].map(x=><article class="pillar"><h3>{lang==='zh'?x[1]:x[0]}</h3><p>{lang==='zh'?x[0]:x[1]}</p></article>)}</div></section><section class="section"><h2>{tx('公司与团队','Company and team')}</h2><p>{tx('公开资料已确认品牌与研究方向。法定名称、成员身份和地址尚待核验，因此暂不列出。','Public sources confirm the brand and research direction. Legal entity details, team identities and address are omitted pending verification.')}</p><a class="text-link" href={company.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></section></>}
 {key==='contact'&&<section class="section"><p class="section-index">{c.labels.social}</p><div class="contact-card"><div><span>01 / PUBLIC CHANNEL</span><h2>GitHub</h2><p>{tx('研究讨论、复现问题、开源贡献。请在对应仓库发起 Issue 或 Pull Request。','Research discussion, reproduction reports and open-source contributions. Use issues or pull requests in the relevant repository.')}</p><code>github.com/kineworld</code></div><a class="button primary" href={company.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></section>}
 {key==='media'&&<><section class="section split"><div><p class="section-index">LOGO</p><h2>{c.labels.mediaUse}</h2><p>{tx('请保持标志原有轮廓、中间负空间与比例。不要把它重画为普通方框或声称它是严格的四维超立方体投影。','Preserve the silhouette, central negative space and proportions. Do not redraw it as a generic box or claim it is a strict tesseract projection.')}</p><div class="button-row"><a class="button secondary" href="/assets/logo-original.jpg" download>{tx('原始 JPG','Original JPG')}</a><a class="button secondary" href="/assets/logo-mark.png" download>{tx('透明 PNG','Transparent PNG')}</a><a class="button secondary" href="/assets/logo-white.png" download>{tx('白色 PNG','White PNG')}</a><a class="button secondary" href="/assets/logo-on-black.png" download>{tx('黑底版本','On black')}</a><a class="button secondary" href="/assets/logo-on-white.png" download>{tx('白底版本','On white')}</a></div></div><div class="brand-visual light"><img src="/assets/logo-mark.png" alt={tx('勘境标志','KineWorld mark')} width="480" height="480" /></div></section><section class="section"><p class="section-index">BRAND</p><div class="pillar-grid"><article class="pillar"><h3>勘境智能</h3><p>KineWorld</p></article><article class="pillar"><h3>COLOR</h3><p>#05070B · #006BFF · #F5F7FA</p></article><article class="pillar"><h3>MEDIA CONTACT</h3><p>{tx('当前未公开核验媒体联系邮箱。','No media email is publicly verified yet.')}</p></article></div></section></>}
 {key==='faq'&&<section class="section faq-list">{faqs.map((f,i)=><details><summary><span>{String(i+1).padStart(2,'0')}</span>{lang==='zh'?f.qZh:f.qEn}</summary><p>{lang==='zh'?f.aZh:f.aEn}</p></details>)}</section>}
 {(key==='privacy'||key==='terms')&&<section class="section legal-copy"><p>{page?.body}</p><p>{key==='privacy'?tx('本网站不主动收集通过表单提交的个人信息，因为目前没有联系表单。若未来启用统计或表单，此页会在上线前更新。','The site does not collect form submissions because it currently has no contact form. This page will be updated before any analytics or forms are enabled.'):tx('内容按发布时可核验的资料编写。研究状态会变化，具体实现和许可应以对应公开仓库的最新文件为准。','Content reflects inspectable information at publication. Research status may change; consult the current files in each public repository for implementation and licensing.')}</p></section>}
 </>}
</Site>
